# Local development template. Do not upload this file to Vercel as a whole.
# In Vercel, add each required key once under Project Settings > Environment Variables.
# PORT is local-only; remove the PORT variable from Vercel because serverless functions do not listen on a fixed port.
PORT=4000
# For Vercel, replace the local MongoDB URL with the Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/web_monitor
# For Vercel, set this to the exact deployed frontend origin (including https://).
CLIENT_ORIGIN=http://localhost:5173
# Use a unique long random secret in Vercel; never use this placeholder in production.
JWT_SECRET=replace-with-a-long-random-secret
# Set unique production credentials in Vercel; do not use these local defaults.
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-password
MAX_WEBSITES=1000
WORKER_CONCURRENCY=2
CHECK_TIMEOUT_MS=30000
NAVIGATION_TIMEOUT_MS=30000
MAX_RETRIES=2
RETRY_DELAY_SECONDS=120
SLOW_PAGE_MS=7000
# Optional: configure Google OAuth to enable a private, auto-updating results sheet.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
DEFAULT_DAILY_TIME=02:00
DEFAULT_TIMEZONE=Asia/Dhaka
INSTANT_ALERTS=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=
